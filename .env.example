# Copy this file to .env.local and fill in your own values.
# The site and /admin both work without these set — they'll just run on the
# static fallback content in lib/content.ts until you connect a real project.

# From sanity.io/manage after creating a free project:
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Optional: only needed if you later add server-side writes/preview mode
# using an authenticated client (not required for the admin studio itself,
# which authenticates via your Sanity login in the browser).
# SANITY_API_TOKEN=

# Contact form recipient (defaults to fidelisolije@olije.com if unset)
CONTACT_FORM_RECIPIENT=fidelisolije@olije.com

# Email Delivery via SMTP (Optional: e.g. Google Workspace, cPanel, Zoho)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="OLIJE Website" <fidelisolije@olije.com>

# Or Email Delivery via Resend (Optional)
# RESEND_API_KEY=
# EMAIL_FROM=OLIJE Website <onboarding@resend.dev>

